{
  "name": "miadly-mockups",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "v1",
    "v2"
  ],
  "scripts": {
    "dev:v1": "npm run dev -w v1",
    "dev:v2": "npm run dev -w v2",
    "build:v1": "npm run build -w v1",
    "build:v2": "npm run build -w v2",
    "lint": "npm run lint -w shared && npm run lint -w v1 && npm run lint -w v2",
    "coverage": "node scripts/generate-coverage.mjs"
  }
}
